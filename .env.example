NODE_ENV=dev
PORT=3478
MONGO_STRING_TEST=mongodb://localhost:27017/fud-crm-test
MONGO_STRING_PROD=mongodb://localhost:27017/fud-crm
JWT_SECRET=change-me-pos
POS_FE_ORIGIN=http://localhost:3477

# Phase 1 event relay and worker. Use a dedicated persistent Redis with noeviction.
EVENT_REDIS_URL=redis://localhost:6379
EVENT_LOG_LEVEL=info
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

# Enable only after deploying CRM guards and running reservation preflight/backfill.
POS_PAYMENT_RESERVATIONS_ENABLED=false
CRM_RESERVATION_GUARDS_DEPLOYED=false
SQUAD_SECRET_KEY=
SQUAD_DVA_APPROVED=false
SQUAD_CONTRACT_VERIFIED=false

# Customer checkout and Moniepoint (disabled until configured)
MONIEPOINT_ENABLED=false
MONIEPOINT_API_BASE_URL=https://api.pos.moniepoint.com
MONIEPOINT_HTTP_TIMEOUT_MS=10000
MONIEPOINT_STATUS_POLL_INTERVAL_MS=15000
MONIEPOINT_ACCOUNTS_JSON={}
MONIEPOINT_TERMINALS_JSON={}
MONIEPOINT_LAGOS_API_KEY=
MONIEPOINT_LAGOS_WEBHOOK_SECRET=
# Optional: set clientIdEnv in an account profile to use the client-credentials flow.
# In that mode apiKeyEnv references the client secret; use the documented channel host.
MONIEPOINT_IFE_CLIENT_ID=
MONIEPOINT_IFE_API_KEY=
MONIEPOINT_IFE_WEBHOOK_SECRET=
SQUAD_ENABLED=false
POS_PAYMENT_WORKER_ENABLED=true
